<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all screen content; this only backs the window/splash chrome. -->
    <style name="Theme.LifeVault" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.LifeVault.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBFBFE</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeVault</item>
    </style>
</resources>
